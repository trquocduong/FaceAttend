<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootProfile"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    tools:context=".ProfileActivity">

    <!-- Khối nền Cyan ở đỉnh trang -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="#00ACC1"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Nút Quay lại (Back Button) -->
    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:src="@android:drawable/ic_menu_revert"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#1A1A1A"
        tools:ignore="ContentDescription" />

    <!-- Tiêu đề trang -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PROFILE &amp; BIOMETRICS"
        android:textColor="#1A1A1A"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnBack" />

    <!-- ScrollView cuộn nội dung trang -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- Container Thẻ thông tin cá nhân & Ảnh đại diện đè lên -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="35dp">

                <!-- Thẻ trắng chứa thông tin chính -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardProfileInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="42dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="52dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="20dp">

                        <TextView
                            android:id="@+id/tvUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nguyen Van A"
                            android:textColor="#1A1A1A"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvUserPosition"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Senior Developer"
                            android:textColor="#666666"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvUserDepartment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Dept: Engineering"
                            android:textColor="#666666"
                            android:textSize="13sp" />

                        <!-- Bảng thuộc tính (ID, Joined, Email) -->
                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:columnCount="2"
                            android:rowCount="3">

                            <TextView
                                android:layout_width="85dp"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="ID:"
                                android:textColor="#1A1A1A"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvUserId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="ITS-0015"
                                android:textColor="#333333"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="85dp"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="Joined:"
                                android:textColor="#1A1A1A"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvUserJoined"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="Jan 2022"
                                android:textColor="#333333"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="85dp"
                                android:layout_height="wrap_content"
                                android:text="Email:"
                                android:textColor="#1A1A1A"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvUserEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="van.a@innotech.com"
                                android:textColor="#333333"
                                android:textSize="13sp" />
                        </GridLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Thẻ Ảnh đại diện nổi bật phía trên -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAvatar"
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    android:layout_gravity="top|center_horizontal"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="4dp">

                    <ImageView
                        android:id="@+id/imgAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/ic_menu_gallery"
                        tools:ignore="ContentDescription" />
                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- Thẻ Đăng ký khuôn mặt (FACE ENROLLMENT) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardFaceEnrollment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FACE ENROLLMENT"
                        android:textColor="#1A1A1A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Trạng thái Registered -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/imgStatusCheck"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@android:drawable/checkbox_on_background"
                                app:tint="#4CAF50"
                                tools:ignore="ContentDescription" />

                            <TextView
                                android:id="@+id/tvFaceStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Registered"
                                android:textColor="#4CAF50"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Nút Update Face -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUpdateFace"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:backgroundTint="#00ACC1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="Update Face"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            app:cornerRadius="20dp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Thẻ Tạo mã QR cá nhân (PERSONAL QR) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPersonalQR"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <!-- Ảnh Mã QR -->
                    <ImageView
                        android:id="@+id/imgQRCode"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@android:drawable/ic_menu_camera"
                        tools:ignore="ContentDescription" />

                    <!-- Nút Generate Personal QR -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGenerateQR"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:backgroundTint="#00ACC1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="Generate\nPersonal QR"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        app:cornerRadius="22dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar cố định ở đáy -->
    <FrameLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="bottom"
            android:background="@android:color/white"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#00ACC1"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/navExplore"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:src="@android:drawable/ic_menu_compass"
                app:tint="#B0BEC5"
                tools:ignore="ContentDescription" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/navNotification"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:src="@android:drawable/ic_popup_reminder"
                app:tint="#B0BEC5"
                tools:ignore="ContentDescription" />

            <!-- Tab Profile đang active -->
            <ImageView
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#00ACC1"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <!-- Nút Nổi trung tâm (QR Barcode Scanner) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnFloatingQR"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="top|center_horizontal"
            app:cardBackgroundColor="#00ACC1"
            app:cardCornerRadius="26dp"
            app:cardElevation="4dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="@android:color/white"
                tools:ignore="ContentDescription" />
        </androidx.cardview.widget.CardView>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>