<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1922"
    tools:context=".HomeActivity">

    <!-- Thanh Tiêu đề Trực quan (Top Bar) -->
    <ImageView
        android:id="@+id/imageViewLogo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:src="@android:drawable/ic_menu_camera"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#00E5FF"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:id="@+id/layoutAppHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/imageViewLogo"
        app:layout_constraintStart_toEndOf="@+id/imageViewLogo"
        app:layout_constraintTop_toTopOf="@+id/imageViewLogo">

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DQ CMP"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLocationBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 Head Office HCM (In Range)"
            android:textColor="#00E5FF"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/buttonSettings"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="20dp"
        android:src="@android:drawable/ic_menu_preferences"
        app:layout_constraintBottom_toBottomOf="@+id/imageViewLogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imageViewLogo"
        app:tint="#00E5FF"
        tools:ignore="ContentDescription" />

    <!-- ScrollView chứa nội dung quét -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewHome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageViewLogo">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- BỘ CHUYỂN CHẾ ĐỘ CHECK IN / CHECK OUT -->
            <LinearLayout
                android:id="@+id/layoutCheckModeToggle"
                android:layout_width="260dp"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:background="#152834"
                android:orientation="horizontal"
                android:padding="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeCheckIn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:backgroundTint="#00E5FF"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="CHECK IN"
                    android:textAllCaps="true"
                    android:textColor="#0A1922"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnModeCheckOut"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="CHECK OUT"
                    android:textAllCaps="true"
                    android:textColor="#B0BEC5"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- KHUNG KHUÔN MẶT HỆ THỐNG SCANNER (HERO COMPONENT) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardScanContainer"
                android:layout_width="290dp"
                android:layout_height="370dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#11232E"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <!-- Camera Preview / Face Image Container -->
                    <ImageView
                        android:id="@+id/imageViewFace"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.8"
                        android:scaleType="centerCrop"
                        tools:ignore="ContentDescription"
                        tools:srcCompat="@tools:sample/avatars" />

                    <!-- Overlay Khung elip định vị khuôn mặt -->
                    <View
                        android:id="@+id/viewFaceFrameGuide"
                        android:layout_width="200dp"
                        android:layout_height="260dp"
                        android:background="@android:drawable/dialog_holo_light_frame"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Badge Liveness Detection (Góc trên Camera) -->
                    <TextView
                        android:id="@+id/tvLivenessBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="#80000000"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:text="🟢 Liveness AI: Ready"
                        android:textColor="#00E5FF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Nút Chạm Quét Trung Tâm -->
                    <ImageButton
                        android:id="@+id/btnTouchToScan"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_camera"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#00E5FF"
                        tools:ignore="ContentDescription" />

                    <!-- Dòng chữ hướng dẫn phía dưới -->
                    <TextView
                        android:id="@+id/textViewTouchHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:text="TOUCH OR LOOK AT CAMERA TO SCAN"
                        android:textColor="#00E5FF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- Trạng thái quét & Phản hồi hệ thống -->
            <TextView
                android:id="@+id/textViewStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="SCANNING: Keeping face inside frame..."
                android:textColor="#B0BEC5"
                android:textSize="13sp" />

            <!-- THẺ THÔNG TIN ĐIỂM DANH HÔM NAY (QUICK STATUS CARD) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardTodayStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#152834"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Today's Check-in"
                            android:textColor="#B0BEC5"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvTodayCheckInTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="08:29 AM (On Time)"
                            android:textColor="@android:color/white"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@android:drawable/checkbox_on_background"
                        app:tint="#4CAF50"
                        tools:ignore="ContentDescription" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Nút xem Lịch sử Điểm danh -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonHistory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="#113F48"
                android:text="VIEW ATTENDANCE HISTORY"
                android:textAllCaps="true"
                android:textColor="#00E5FF"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="26dp"
                app:strokeColor="#00E5FF"
                app:strokeWidth="1dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Navigation Bar Đồng Bộ Chuẩn Toàn App -->
    <FrameLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="bottom"
            android:background="#11232E"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#00E5FF"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/navSchedule"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:src="@android:drawable/ic_menu_today"
                app:tint="#B0BEC5"
                tools:ignore="ContentDescription" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/navNotification"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:src="@android:drawable/ic_popup_reminder"
                app:tint="#B0BEC5"
                tools:ignore="ContentDescription" />

            <ImageView
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#B0BEC5"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <!-- Nút Nổi Trung Tâm (Camera Scan Active) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btnFloatingQR"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="top|center_horizontal"
            app:cardBackgroundColor="#00E5FF"
            app:cardCornerRadius="26dp"
            app:cardElevation="6dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="#0A1922"
                tools:ignore="ContentDescription" />
        </androidx.cardview.widget.CardView>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>